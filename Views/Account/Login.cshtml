@model LoginViewModel
@{
    ViewData["Title"] = "Librarian Sign In";
}

<h1>Librarian Sign In</h1>
<p>Staff access to book/user registration, loan confirmation, returns, and reservation management.</p>

<div class="card" style="max-width: 420px;">
    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label style="display:flex; align-items:center; gap:0.5rem;">
                <input asp-for="RememberMe" style="width:auto;" />
                Remember me
            </label>
        </div>

        <button type="submit" class="btn btn-primary">Sign In</button>
    </form>
</div>
