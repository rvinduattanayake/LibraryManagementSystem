@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="mx-auto max-w-md">
    <div class="page-header">
        <span class="page-header-icon">@Icon.Svg("lock-closed")</span>
        <div class="page-header-text">
            <h1>Sign In</h1>
            <p>Members can sign in to manage loans, reservations, and fines. Librarians get full access to registration, confirmations, returns, and reports.</p>
        </div>
    </div>

    <div class="card">
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="username" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="checkbox-row">
                    <input asp-for="RememberMe" />
                    Remember me
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-full">@Icon.Svg("lock-closed", "w-4 h-4") Sign In</button>
        </form>
    </div>

    <p class="text-subtle mt-4 text-center">Not a member yet? <a asp-controller="Account" asp-action="RegisterMember">Create an account</a>.</p>
</div>
