@{
    ViewData["Title"] = "Outstanding Fines";
    var finePage = ViewBag.Fines as PagedResult<FineListItemViewModel> ?? new();
    var fines = finePage.Items;
}

<h1>Outstanding Fines</h1>
<p>Overdue fines are calculated automatically at return time (@LibraryConstants.FinePerDayOverdue.ToString("C") per day late).</p>

<div class="card">
    @if (fines.Count == 0)
    {
        <p>No outstanding fines.</p>
    }
    else
    {
        <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Borrower</th>
                    <th>Title</th>
                    <th>Copy</th>
                    <th>Due</th>
                    <th>Returned</th>
                    <th>Fine</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var fine in fines)
            {
                var confirmMessage = $"Mark the {fine.FineAmount:C} fine for {fine.BorrowerName} as paid?";
                <tr>
                    <td>@fine.BorrowerName (@fine.UserNumber)</td>
                    <td>@fine.BookTitle</td>
                    <td>@fine.AccessionNumber</td>
                    <td>@fine.DueDate.ToString("yyyy-MM-dd")</td>
                    <td>@fine.ReturnedAt.ToString("yyyy-MM-dd")</td>
                    <td>@fine.FineAmount.ToString("C")</td>
                    <td>
                        <form asp-action="MarkPaid" method="post" data-confirm="@confirmMessage">
                            <input type="hidden" name="loanId" value="@fine.LoanId" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success">Mark paid</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        <partial name="_Pager" model="finePage" />
    }
</div>
