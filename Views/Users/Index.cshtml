@{
    ViewData["Title"] = "Borrowers";
    var borrowerPage = ViewBag.Borrowers as PagedResult<BorrowerListItemViewModel> ?? new();
    var borrowers = borrowerPage.Items;
}

<h1>Borrowers</h1>
<p><a asp-action="Register" class="btn btn-primary btn-sm">Register a new borrower</a></p>

<div class="card">
    @if (borrowers.Count == 0)
    {
        <p>No borrowers registered yet.</p>
    }
    else
    {
        <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>User No.</th>
                    <th>Name</th>
                    <th>National ID</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var borrower in borrowers)
            {
                <tr>
                    <td>@borrower.UserNumber</td>
                    <td>@borrower.Name</td>
                    <td>@borrower.NationalIdNumber</td>
                    <td><a asp-action="Edit" asp-route-id="@borrower.Id" class="btn btn-sm btn-primary">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        <partial name="_Pager" model="borrowerPage" />
    }
</div>
