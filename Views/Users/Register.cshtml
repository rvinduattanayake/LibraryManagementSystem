@model UserRegistrationViewModel
@{
    ViewData["Title"] = "User Registration";
}

<div class="page-header">
    <span class="page-header-icon">@Icon.Svg("user-plus")</span>
    <div class="page-header-text">
        <h1>User Registration</h1>
        <p>Register a new borrower in the library system. <a asp-action="Index">View all borrowers</a> to correct an existing record.</p>
    </div>
</div>

<div class="card">
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="UserNumber"></label>
                <input asp-for="UserNumber" placeholder="e.g. U2026001" />
                <span asp-validation-for="UserNumber" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Sex"></label>
                <select asp-for="Sex" asp-items="Html.GetEnumSelectList<Sex>()"></select>
            </div>

            <div class="form-group">
                <label asp-for="NationalIdNumber"></label>
                <input asp-for="NationalIdNumber" />
                <span asp-validation-for="NationalIdNumber" class="field-validation-error"></span>
            </div>

            <div class="form-group span-2">
                <label asp-for="Address"></label>
                <textarea asp-for="Address"></textarea>
                <span asp-validation-for="Address" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" placeholder="borrower@example.com" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" placeholder="Optional" />
                <span asp-validation-for="Phone" class="field-validation-error"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">@Icon.Svg("user-plus", "w-4 h-4") Register Borrower</button>
        </div>
    </form>
</div>
