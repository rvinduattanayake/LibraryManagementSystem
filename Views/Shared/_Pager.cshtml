@model IPagedResult
@functions {
    string PageLink(int page)
    {
        var parts = Context.Request.Query
            .Where(kv => !string.Equals(kv.Key, "page", StringComparison.OrdinalIgnoreCase))
            .SelectMany(kv => kv.Value.Select(v => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(v ?? string.Empty)}"))
            .ToList();
        parts.Add($"page={page}");
        return Context.Request.Path + "?" + string.Join("&", parts);
    }
}
@if (Model.TotalPages > 1)
{
    <nav class="pager" aria-label="Pagination">
        @if (Model.HasPrevious)
        {
            <a class="btn btn-sm btn-primary" href="@PageLink(Model.Page - 1)">&larr; Previous</a>
        }
        else
        {
            <span class="btn btn-sm btn-disabled" aria-disabled="true">&larr; Previous</span>
        }
        <span class="pager-status">Page @Model.Page of @Model.TotalPages</span>
        @if (Model.HasNext)
        {
            <a class="btn btn-sm btn-primary" href="@PageLink(Model.Page + 1)">Next &rarr;</a>
        }
        else
        {
            <span class="btn btn-sm btn-disabled" aria-disabled="true">Next &rarr;</span>
        }
    </nav>
}
